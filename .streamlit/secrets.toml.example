# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요. secrets.toml 은 커밋하지 않습니다(.gitignore).
# Streamlit Community Cloud 에서는 앱 설정의 Secrets 칸에 같은 형식으로 넣습니다.
# 키가 없으면 앱은 AI 없이 동의어 매칭만 사용합니다.

GEMINI_API_KEY = ""
# GEMINI_MODEL = ""   # 비워 두면 기본 모델(engine/ai_match.py 의 DEFAULT_MODEL)

# 업로드·처리 제한 (engine/limits.py). 비워 두면 로컬 기본값.
# Streamlit Community Cloud 무료 서버(메모리 약 1GB)에서는 "cloud" 로 두세요.
# EXCEL_MERGER_PROFILE = "cloud"
# 항목마다 따로 바꿀 수도 있습니다 (엔진 안전 상한보다 크게는 안 됨):
# MAX_FILES = 10
# MAX_FILE_MB = 5
# MAX_TOTAL_UPLOAD_MB = 20
# MAX_ROWS_PER_FILE = 10000
# MAX_TOTAL_ROWS = 30000
# TIME_LIMIT_SECONDS = 45
# MAX_CONCURRENT_JOBS = 1
# JOB_MEMORY_MB = 400
